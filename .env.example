# Server
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/learning_bot

# Session
SESSION_SECRET=your-super-secret-session-key-change-in-production
SESSION_MAX_AGE=86400000

# Default Admin (используется только при первой миграции)
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=change_this_password

# VK Bot
VK_GROUP_ID=123456789
VK_CONFIRMATION_TOKEN=your-confirmation-token
VK_ACCESS_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VK_SECRET=your-secret-key

# MAX Bot
MAX_BOT_TOKEN=f9LHodD0cOKnAh9tpU7Sm0qhVPIwJ_hDGExKRx6xXzUXiVRclY2HwISyr78eyx-e-2sR4YEtscn7Df488bBM
MAX_API_URL=https://api.max.ru

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=500

# S3 Storage (опционально, если STORAGE_TYPE=s3)
S3_ENDPOINT=https://s3.timeweb.cloud
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=learning-bot-files
S3_REGION=ru-1

# Payment Gateways
VKPAY_MERCHANT_ID=your-merchant-id
VKPAY_SECRET_KEY=your-secret-key

YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

CLOUDPAYMENTS_PUBLIC_ID=pk_xxxxxxxxxxxxxxxx
CLOUDPAYMENTS_API_SECRET=your-api-secret

DEFAULT_PAYMENT_GATEWAY=vkpay

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
